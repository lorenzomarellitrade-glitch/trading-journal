# Copia questo file in .env e compila con i valori del tuo progetto Supabase.
# Supabase Dashboard → Project Settings → API

# URL del progetto, es. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Chiave pubblica "anon". È pensata per stare nel browser: la sicurezza dei dati
# è garantita dalle policy RLS definite in supabase/schema.sql.
# NON usare mai qui la chiave "service_role".
VITE_SUPABASE_ANON_KEY=
